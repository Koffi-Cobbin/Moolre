# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://moolre:moolre@localhost:5432/moolre

# Moolre — see plan Section 10
MOOLRE_ENV=sandbox            # sandbox | live
MOOLRE_API_USER=your-api-username
MOOLRE_API_KEY=                # required for transfers/account admin (live only in sandbox this can stay blank)
MOOLRE_API_PUBKEY=             # required for payment collection endpoints
MOOLRE_API_VASKEY=your-vas-key # required for SMS/WhatsApp

# Encryption key for wallet secrets at rest (django-cryptography)
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key
